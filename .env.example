# ── Claude / Anthropic ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Kaggle (https://www.kaggle.com/settings → API → Create New Token) ─────────
KAGGLE_USERNAME=your_username
KAGGLE_KEY=your_api_key

# ── Weights & Biases (https://wandb.ai/settings) ──────────────────────────────
WANDB_API_KEY=your_wandb_key
WANDB_PROJECT=experimenter          # default W&B project name

# ── GCP / Vertex AI ───────────────────────────────────────────────────────────
# Leave blank to use local compute only
GCP_PROJECT_ID=
GCP_REGION=us-central1
GCS_BUCKET=                         # e.g. my-project-experimenter-data
# Path to service account JSON, or leave blank to use ADC (gcloud auth)
GOOGLE_APPLICATION_CREDENTIALS=

# ── Local settings ────────────────────────────────────────────────────────────
# Directory for cached datasets and experiment artefacts (~/.experimenter by default)
EXPERIMENTER_DATA_DIR=

# Default compute backend: "local" | "vertex_ai" | "auto"
DEFAULT_COMPUTE=auto

# Claude model used for planning and reporting
PLANNER_MODEL=claude-opus-4-6
REPORTER_MODEL=claude-sonnet-4-6
